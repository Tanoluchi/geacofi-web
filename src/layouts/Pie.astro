---
import { local, turnosTexto } from '../lib/data.ts';
import { logoUrl } from '../lib/assets.ts';
import ranaFiltrado from '../assets/pie/rana-filtrado-verde.svg?url';
---
<footer class="pie">
  <div class="rana-caja" aria-hidden="true">
    <img class="rana" src={ranaFiltrado} alt="" width="540" height="570" />
    <svg viewBox="0 0 540 570" fill="none" stroke="var(--verde)" stroke-width="5" stroke-linecap="round" focusable="false">
      <path class="chorro" d="M407 414c2 10 1 22 3 32" />
      <path class="chorro gota" d="M428 506v26" />
      <path class="vapor v1" d="M452 440c-8-10 8-16 0-26s6-14 2-22" />
      <path class="vapor v2" d="M482 440c-8-10 8-16 0-26s6-14 2-22" />
      <path class="vapor v3" d="M510 442c-7-9 7-14 0-23" />
    </svg>
  </div>
  <div class="fila">
    <div class="col">
      <img src={logoUrl('crema')} alt="geacofi" height="50" />
      <span class="dir">Café de especialidad · {local.direccion}, {local.ciudad}</span>
      <span class="horas">{turnosTexto}</span>
    </div>
    <div class="links">
      <a href={local.whatsapp} rel="noopener">WhatsApp</a>
      <a href={local.instagram} rel="noopener">Instagram @geacofi</a>
      <a href={local.maps} rel="noopener">Cómo llegar</a>
    </div>
    {local.nominacion && <span class="nota">{local.nominacion}</span>}
  </div>
</footer>
<style>
  .pie { position: relative; background: var(--terracota); color: var(--durazno); padding: 44px var(--side); margin-top: 230px; }
  .fila { max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 22px; align-items: flex-start; justify-content: space-between; }
  .col { display: flex; flex-direction: column; gap: 10px; }
  .col img { height: 50px; width: auto; align-self: flex-start; }
  .dir { font-size: 15px; }
  .horas { font: 13px/1.4 var(--font-mono); }
  .links { display: flex; flex-direction: column; gap: 8px; font: italic 800 22px/1.2 var(--font-cond); }
  .links a { color: var(--durazno); }
  .nota { font: 12px/1.5 var(--font-mono); max-width: 260px; }

  /* la rana sirviendo, parada sobre el borde del pie (donde antes se asomaba) */
  .rana-caja { position: absolute; left: 50%; top: 0; width: 220px; aspect-ratio: 540 / 570; transform: translate(-50%, -96%); }
  .rana-caja img, .rana-caja svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .chorro { stroke-dasharray: 6 9; }
  .vapor { opacity: .55; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.pie.en-vista) .rana-caja > * { animation: respira 3.2s ease-in-out infinite; }
    :global(.pie.en-vista) .chorro { animation: fluye .8s linear infinite; }
    :global(.pie.en-vista) .gota { animation-duration: 1.1s; }
    :global(.pie.en-vista) .vapor { animation: sube 2.6s ease-out infinite; }
    :global(.pie.en-vista) .v2 { animation-delay: .8s; }
    :global(.pie.en-vista) .v3 { animation-delay: 1.6s; }
  }
  @keyframes respira { 50% { transform: translateY(-5px); } }
  @keyframes fluye { to { stroke-dashoffset: -30; } }
  @keyframes sube { 0% { opacity: 0; transform: translateY(8px); } 25% { opacity: .6; } 100% { opacity: 0; transform: translateY(-12px); } }

  @media (max-width: 640px) {
    .pie { padding: 28px 18px 36px; margin-top: 180px; }
    .rana-caja { width: 170px; }
  }
</style>
<script>
  const pie = document.querySelector<HTMLElement>('footer.pie');
  if (pie) new IntersectionObserver(([e]) => pie.classList.toggle('en-vista', e.isIntersecting)).observe(pie);
</script>
