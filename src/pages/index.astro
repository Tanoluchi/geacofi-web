---
import Base from '../layouts/Base.astro';
import Intro from '../components/home/Intro.astro';
import Hero from '../components/home/Hero.astro';
import Destacados from '../components/home/Destacados.astro';
import Vaso3D from '../components/home/Vaso3D.astro';
import SobreSeccion from '../components/home/SobreSeccion.astro';
import Filtrados from '../components/home/Filtrados.astro';
import EventosHome from '../components/home/EventosHome.astro';
import Resenas from '../components/home/Resenas.astro';
import Visita from '../components/home/Visita.astro';
import { local } from '../lib/data.ts';
---
<Base title="café, discos y eso…" description={`Café de especialidad en ${local.direccion}, ${local.ciudad}. Carta, eventos y cómo llegar.`}>
  <Intro />
  <Hero />
  <Destacados />
  <Vaso3D />
  <SobreSeccion />
  <Filtrados />
  <EventosHome />
  <Resenas />
  <Visita />
</Base>
