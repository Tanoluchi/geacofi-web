---
// Sobre de cafés: sobre → corte + ola de vapor + papelitos → 5 figuritas que salen y se abren en abanico.
// Datos: cafes.json (solo en_barra) vía src/lib; el sorteo es elegirSobre() de src/lib/sobre.ts, también en el cliente.
import Boton from '../shared/Boton.astro';
import { cafes } from '../../lib/data.ts';
import { ranaUrl } from '../../lib/assets.ts';
import { POSES_CAFE, TEXTO_SIN_CAFES } from '../../lib/sobre.ts';

const enBarra = cafes.cafes.filter((c) => c.en_barra);
const quitar = (p: string) => p.replace(/^rana-/, '');
const poses = [...new Set([...POSES_CAFE, ...enBarra.flatMap((c) => (c.pose ? [quitar(c.pose)] : []))])];
const ranas = Object.fromEntries(
  poses.map((p) => [p, { carbon: ranaUrl(p, 'verde'), crema: ranaUrl(p, 'crema') }]), // keyed by card ink: carbón-ink cards get the green rana
);
// número de figurita = posición del café en la lista de la barra
const numeros = Object.fromEntries(enBarra.map((c, i) => [c.id, i + 1]));
const datos = { tostadores: cafes.tostadores, cafes: enBarra, ranas, numeros, texto: TEXTO_SIN_CAFES };
---
<section class="sobre" data-sobre aria-label="sobre de cafés">
  <div class="stage" data-stage>
    <canvas class="fx" data-fx aria-hidden="true"></canvas>
    <button class="pack" type="button" data-pack aria-label="abrir el sobre de cafés">
      <span class="float">
        <span class="pack-top" data-top></span>
        <span class="pack-body">
          <span class="wordmark">geacofi</span>
          <img class="rana" src={ranas.oficial.crema} alt="" width="190" height="190" />
          <span class="label">sobre de cafés · 5 figuritas</span>
        </span>
        <span class="hint">tocá para abrir</span>
      </span>
    </button>
    <div data-cards></div>
  </div>

  <div class="controls">
    <div data-again hidden><Boton data-again-btn>abrir otro sobre</Boton></div>
    <p class="status" role="status" data-status></p>
  </div>

  <div class="todos">
    <div class="invita">
        <svg class="deco" viewBox="0 0 220 60" aria-hidden="true">
          <g fill="#6B3E26" stroke="#4A2A1A" stroke-width="2.5" stroke-linejoin="round">
            <ellipse cx="26" cy="36" rx="17" ry="12" transform="rotate(-24 26 36)" /><ellipse cx="150" cy="24" rx="14" ry="10" transform="rotate(30 150 24)" /><ellipse cx="196" cy="42" rx="16" ry="11" transform="rotate(-10 196 42)" />
          </g>
          <g fill="none" stroke="#2a150b" stroke-width="2.5" stroke-linecap="round">
            <path d="M12 41c8-9 16 5 28-10" /><path d="M139 29c6-6 12 4 21-9" /><path d="M183 46c7-7 14 3 25-8" />
          </g>
          <g fill="#BF834E" stroke="#783E32" stroke-width="2" stroke-linejoin="round">
            <path d="M80 6l5 14 14 5-14 5-5 14-5-14-14-5 14-5z" /><path d="M112 36l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" /><path d="M54 40l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" />
          </g>
        </svg>
        <h4>siempre hay algo nuevo en la barra</h4>
        <p>los cafés van rotando: cada tanto llegan nuevos de nuestros tostadores invitados. pasá a descubrir aromas nuevos y algo rico para acompañar.</p>
        <small>{cafes.tostadores.map((t) => t.nombre).join(" · ")}</small>
        <Boton href="/visitanos">cómo llegar</Boton>
    </div>
  </div>

  <dialog class="detalle" data-dialog aria-labelledby="sobre-d-titulo">
    <form method="dialog"><button class="cerrar" aria-label="cerrar">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
    </button></form>
    <div data-d-card></div>
    <div class="info">
      <p class="por" data-d-por></p>
      <h3 id="sobre-d-titulo" data-d-title></h3>
      <dl data-d-list></dl>
      <p class="nota">preguntá en la barra si está hoy y en qué método conviene tomarlo.</p>
    </div>
  </dialog>

  <script type="application/json" data-sobre-datos is:inline set:html={JSON.stringify(datos)} />
</section>

<style is:global>
  .sobre { color: var(--ink); overflow-x: clip; } /* the torn strip flies off sideways; clip, not hidden, keeps the rainbow free above */
  .sobre .stage { position: relative; height: 600px; perspective: 1400px; touch-action: manipulation; transition: height .5s cubic-bezier(.16,1,.3,1); }
  .sobre [data-cards] { transition: transform .5s cubic-bezier(.16,1,.3,1); }
  .sobre .fx { position: absolute; left: 0; top: -260px; width: 100%; height: calc(100% + 260px); pointer-events: none; z-index: 5; }

  /* ---- sobre */
  .sobre .pack { --pack: var(--terracota); position: absolute; left: 50%; top: 50%; width: 250px; height: 350px; margin: -185px 0 0 -125px; padding: 0; border: 0; background: none; cursor: pointer; z-index: 2; }
  .sobre .pack:focus-visible { outline: 3px solid var(--focus); outline-offset: 10px; border-radius: 18px; }
  .sobre .pack .float { position: absolute; inset: 0; animation: sobre-bob 3.2s ease-in-out infinite; }
  .sobre .pack:hover .float { animation-duration: 1.4s; }
  .sobre .pack-body { position: absolute; inset: 34px 0 0; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 20px 14px 14px; overflow: hidden; background: var(--pack); border: var(--border-ink) solid var(--bordo); border-radius: 6px 6px 18px 18px; box-shadow: 8px 10px 0 var(--bordo); }
  .sobre .pack-body::after { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,.22) 45%, transparent 60%); transform: translateX(-60%); animation: sobre-shine 3.6s ease-in-out infinite; }
  .sobre .pack-top { position: absolute; left: 0; right: 0; top: 0; height: 40px; z-index: 2; background: var(--pack); border: var(--border-ink) solid var(--bordo); border-bottom: 0; border-radius: 10px 10px 0 0; transform-origin: 20% 100%; }
  .sobre .pack-top::before { content: ""; position: absolute; left: 8px; right: 8px; top: 6px; height: 10px; border-radius: 4px; background: repeating-linear-gradient(90deg, rgba(0,0,0,.18) 0 6px, transparent 6px 12px); }
  .sobre .pack-top::after { content: "cortá acá"; position: absolute; left: 0; right: 0; bottom: -2px; padding-right: 10px; border-bottom: 3px dashed var(--crema); text-align: right; letter-spacing: .06em; font: 500 11px/1.4 var(--font-mono); color: var(--crema); }
  .sobre .wordmark { margin-top: 6px; font: italic 800 44px/1 var(--font-cond); color: var(--crema); }
  .sobre .pack .rana { width: 170px; height: auto; margin-top: -2px; }
  .sobre .pack .label { margin-top: auto; font: 500 11px/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--crema); }
  .sobre .pack .hint { position: absolute; left: 50%; bottom: -62px; white-space: nowrap; transform: translateX(-50%) rotate(-2deg); padding: 4px 16px; background: var(--crema); color: var(--bordo); border: var(--border-ink) solid var(--bordo); border-radius: var(--radius-pill); box-shadow: var(--sticker-sm); font: italic 800 22px/1.2 var(--font-cond); }
  .sobre .pack.is-open { pointer-events: none; }
  .sobre .pack.is-gone { visibility: hidden; }
  .sobre .pack-body { transform-origin: 50% 100%; }

  /* ---- figuritas */
  .sobre .card { position: absolute; left: 0; top: 0; width: var(--cw); height: calc(var(--cw) * 1.42); padding: 0; border: 0; background: none; cursor: pointer; z-index: 4; transform-style: preserve-3d; font: inherit; color: inherit; text-align: left; }
  .sobre .card:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; border-radius: calc(var(--cw) * .07); }
  .sobre .card .inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .sobre .face { position: absolute; inset: 0; overflow: hidden; backface-visibility: hidden; border: var(--border-ink) solid var(--bordo); border-radius: calc(var(--cw) * .07); box-shadow: var(--drop); }
  .sobre .back { transform: rotateY(180deg); display: flex; align-items: center; justify-content: center; background: #E7C79C; }
  .sobre .back::before { content: ""; position: absolute; inset: 7%; border: var(--border-dash) dashed var(--bordo); border-radius: calc(var(--cw) * .05); }
  .sobre .back .q { font: 700 calc(var(--cw) * .5)/1 var(--font-display); color: var(--terracota); }
  .sobre .front { display: flex; flex-direction: column; padding: calc(var(--cw) * .06); background: var(--bg); color: var(--ink-f); }
  .sobre .front .top { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; font: italic 800 calc(var(--cw) * .085)/1 var(--font-cond); }
  .sobre .front .num { font: 500 calc(var(--cw) * .055)/1 var(--font-mono); font-style: normal; opacity: .8; }
  .sobre .front .art { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; margin: calc(var(--cw) * .04) 0; padding: 6%; border-radius: calc(var(--cw) * .05); background: var(--panel); }
  .sobre .front .art img { max-height: 100%; max-width: 100%; width: auto; height: auto; }
  .sobre .front .name { font: 700 calc(var(--cw) * .15)/.9 var(--font-display); text-wrap: balance; }
  .sobre .front .meta { margin-top: calc(var(--cw) * .02); font: 500 calc(var(--cw) * .056)/1.3 var(--font-mono); opacity: .9; }
  .sobre .front .tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: calc(var(--cw) * .035); }
  .sobre .front .tag { padding: 4px 7px; border-radius: var(--radius-pill); background: var(--ink-f); color: var(--bg); font: 800 calc(var(--cw) * .05)/1 var(--font-body); }
  .sobre .sheen { position: absolute; inset: 0; border-radius: calc(var(--cw) * .07); pointer-events: none; opacity: 0; mix-blend-mode: soft-light; transition: opacity .3s; background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.75), transparent 55%); }
  .sobre .holo .sheen { opacity: .55; mix-blend-mode: color-dodge; background-size: 100% 100%, 220% 220%; background-position: center, var(--mx, 50%) var(--my, 50%);
    background-image: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.55), transparent 45%), linear-gradient(115deg, transparent 20%, rgba(255,92,180,.45) 35%, rgba(90,200,255,.45) 50%, rgba(140,255,170,.45) 65%, transparent 80%); }
  .sobre .card:hover .sheen, .sobre .card:focus-visible .sheen { opacity: 1; }

  /* ---- controles */
  .sobre .controls { display: flex; flex-direction: column; align-items: center; gap: 10px; min-height: 90px; margin-top: 10px; }
  .sobre .controls [hidden] { display: none; }
  .sobre .status { margin: 0; font: 500 13px/1.4 var(--font-mono); color: var(--ink-muted); }

  /* ---- invitación bajo el sobre */
  .sobre .todos { max-width: 520px; margin: 40px auto 0; }
  .sobre .invita { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 16px 18px; background: var(--durazno); color: var(--ink-dia); border: 3px dashed var(--bordo); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); outline: 3px solid rgba(245,197,66,.6); outline-offset: 5px; }
  .sobre .invita .deco { width: 100%; max-width: 200px; height: auto; align-self: flex-start; }
  .sobre .invita h4 { margin: 0; font: 700 34px/.95 var(--font-display); color: var(--terracota); text-wrap: balance; }
  .sobre .invita p { margin: 0; font-size: 15px; }
  .sobre .invita small { font: 500 12px/1.4 var(--font-mono); letter-spacing: .06em; color: var(--ink-muted-dia); }
  .sobre .invita .boton { align-self: flex-start; margin-top: auto; }

  /* ---- detalle */
  .sobre .detalle { width: min(760px, calc(100vw - 32px)); padding: 26px; background: var(--crema); color: var(--ink-dia); border: var(--border-ink) solid var(--bordo); border-radius: var(--radius-xl); box-shadow: 10px 10px 0 var(--bordo); overflow: visible; }
  .sobre .detalle[open] { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 26px; animation: sobre-in .3s cubic-bezier(.2,.8,.2,1); }
  .sobre .detalle::backdrop { background: rgba(20,23,27,.7); }
  .sobre .detalle .card { position: relative; cursor: default; }
  .sobre .detalle .info { flex: 1 1 260px; display: flex; flex-direction: column; gap: 10px; }
  .sobre .detalle .por { margin: 0; font: 500 13px/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--terracota); }
  .sobre .detalle h3 { margin: 0; font: 700 56px/.9 var(--font-display); color: var(--terracota); }
  .sobre .detalle dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 6px 0 0; font-size: 15px; }
  .sobre .detalle dt { padding-top: 3px; font: 500 12px/1.3 var(--font-mono); text-transform: uppercase; color: var(--ink-muted-dia); }
  .sobre .detalle dd { margin: 0; font-weight: 800; }
  .sobre .detalle .nota { margin: 0; font-size: 14px; color: var(--ink-muted-dia); }
  .sobre .cerrar { position: absolute; top: 12px; right: 12px; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: var(--border-ink) solid var(--bordo); border-radius: 50%; background: var(--durazno); color: var(--bordo); cursor: pointer; }
  .sobre .cerrar:focus-visible { outline: 3px solid var(--carbon); outline-offset: 3px; }

  @keyframes sobre-bob { 0%, 100% { transform: translateY(0) rotate(-1.5deg); } 50% { transform: translateY(-10px) rotate(1.5deg); } }
  @keyframes sobre-shine { 0%, 60% { transform: translateX(-80%); } 100% { transform: translateX(80%); } }
  @keyframes sobre-in { from { opacity: 0; transform: translateY(20px) scale(.96); } }

  @media (max-width: 700px) {
    .sobre .stage { height: 560px; }
    .sobre .pack { transform: scale(.86); }
    .sobre .detalle h3 { font-size: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sobre .pack .float, .sobre .pack-body::after, .sobre .detalle[open] { animation: none; }
    .sobre .card .inner, .sobre .sheen, .sobre .stage, .sobre [data-cards] { transition: none; }
  }
</style>

<script>
  import { elegirSobre } from '../../lib/sobre.ts';
  import type { Cafe, Tostador } from '../../lib/types.ts';
  import type { Figurita } from '../../lib/sobre.ts';

  interface Datos { tostadores: Tostador[]; cafes: Cafe[]; ranas: Record<string, { carbon: string; crema: string }>; numeros: Record<string, number>; texto: string }

  const root = document.querySelector<HTMLElement>('[data-sobre]')!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const D: Datos = JSON.parse($('[data-sobre-datos]').textContent!);
  const stage = $('[data-stage]'), pack = $<HTMLButtonElement>('[data-pack]'), top = $('[data-top]'), cardsEl = $('[data-cards]');
  const again = $('[data-again]'), againBtn = $('[data-again-btn]'), status = $('[data-status]'), dlg = $<HTMLDialogElement>('[data-dialog]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const PACKS = ['--terracota', '--verde', '--bordo', '--carbon'];
  const FX = ['--terracota', '--durazno', '--verde', '--tostador-komun', '--crema', '--ambar', '--tostador-motofeca', '--bordo'];
  const EASE = 'cubic-bezier(.2,.8,.2,1)';
  let packIdx = 0, hand: Figurita[] = [], busy = false;

  const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

  // ---------------------------------------------------------------- figurita
  function cardHTML(f: Figurita, cw: number, tag: 'button' | 'div' = 'button') {
    const t = f.tostador, carbon = t.tinta === 'carbon';
    const c = f.tipo === 'cafe' ? f.cafe : null;
    const notas = c?.notas?.slice(0, 3) ?? [];
    const tags = f.tipo === 'semana' ? [] : notas.length ? notas : [c!.proceso, c!.mood].filter(Boolean);
    const meta = f.tipo === 'semana' ? 'preguntá en la barra' : [c!.origen, notas.length ? c!.proceso : null].filter(Boolean).join(' · ');
    const nombre = f.tipo === 'semana' ? 'café de la semana' : c!.nombre;
    const num = c ? '#' + String(D.numeros[c.id]).padStart(2, '0') : '';
    const label = tag === 'button' ? ` type="button" aria-label="${esc(nombre)}, de ${esc(t.nombre)}. ver detalle"` : '';
    return `<${tag} class="card${t.holo ? ' holo' : ''}"${label} style="--cw:${cw}px;--bg:var(--${t.color});--ink-f:var(--${t.tinta});--panel:${carbon ? 'rgba(255,255,255,.45)' : 'rgba(255,255,255,.1)'}">
      <span class="inner">
        <span class="face back"><span class="q">?</span></span>
        <span class="face front">
          <span class="top"><span>${esc(t.nombre)}</span><span class="num">${num}</span></span>
          <span class="art"><img src="${D.ranas[f.pose]?.[t.tinta] ?? D.ranas.espresso[t.tinta]}" alt=""></span>
          <span class="name">${esc(nombre)}</span>
          <span class="meta">${esc(meta)}</span>
          <span class="tags">${tags.map((n) => `<span class="tag">${esc(n)}</span>`).join('')}</span>
        </span>
        <span class="sheen"></span>
      </span></${tag}>`;
  }

  // inclinación 3D hasta 22° y brillo que sigue al cursor
  function tilt(card: HTMLElement) {
    if (reduce) return;
    const inner = card.querySelector<HTMLElement>('.inner')!;
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - .5, py = (e.clientY - r.top) / r.height - .5;
      inner.style.transform = `translateZ(30px) scale(1.06) rotateY(${px * 22}deg) rotateX(${-py * 22}deg)`;
      inner.style.setProperty('--mx', (px + .5) * 100 + '%');
      inner.style.setProperty('--my', (py + .5) * 100 + '%');
      card.style.zIndex = '6';
    });
    card.addEventListener('pointerleave', () => { inner.style.transform = ''; card.style.zIndex = ''; });
  }

  // ---------------------------------------------------------------- disposición del abanico
  function layout() {
    const W = stage.clientWidth, H = stage.clientHeight, n = 5, small = W < 700, gap = small ? 12 : 22;
    const pos: [number, number, number][] = [];
    let cw: number;
    if (small) {
      cw = Math.min(150, (W - gap * 2 - 8) / 3);
      const ch = cw * 1.42, y1 = H / 2 - ch - gap / 2, y2 = H / 2 + gap / 2;
      const x1 = (W - (cw * 3 + gap * 2)) / 2, x2 = (W - (cw * 2 + gap)) / 2;
      for (let i = 0; i < 3; i++) pos.push([x1 + i * (cw + gap), y1, 0]);
      for (let i = 0; i < 2; i++) pos.push([x2 + i * (cw + gap), y2, 0]);
    } else {
      cw = Math.min(205, (W - gap * (n - 1) - 20) / n);
      const x0 = (W - (cw * n + gap * (n - 1))) / 2, ch = cw * 1.42;
      for (let i = 0; i < n; i++) { const k = i - (n - 1) / 2; pos.push([x0 + i * (cw + gap), H / 2 - ch / 2 - 20 + Math.abs(k) * 10, k * 2.2]); }
    }
    return { cw, pos };
  }
  const place = (el: HTMLElement, [x, y, r]: number[]) => { el.style.transform = `translate(${x}px,${y}px) rotate(${r}deg)`; };

  // ---------------------------------------------------------------- efectos: luces, arcoíris, granos y papelitos
  // El canvas se extiende PAD px por encima del escenario (el arcoíris sale por arriba). Solo corre mientras hay algo que dibujar y está a la vista.
  const PAD = 260, TAU = Math.PI * 2;
  const fx = $<HTMLCanvasElement>('[data-fx]'), ctx = fx.getContext('2d')!;
  const RAIN = ['#E5484D', '#F0842C', '#F5C542', '#5DB86B', '#4F8FD9', '#8B6FD1'];
  const BEANS: [string, string, string][] = [['#8A5236', '#B98159', '#4A2A1A'], ['#6B3E26', '#9A6342', '#3A1E10'], ['#4A2A1A', '#7C4D31', '#241106']];
  type P = { x: number; y: number; vx: number; vy: number; r: number; vr: number; f: number; vf: number; ph: number; spr: HTMLCanvasElement | null; c: string; s: number; dead: number; t0: number; keep: boolean; st: 0 | 1 | 2; ts: number; tk: number; sx: number; sy: number; sr: number; sf: number; ss: number; tx: number; ty: number; tr: number; tf: number };
  type Spark = { x: number; y: number; t0: number; d: number; s: number; r: number };
  let parts: P[] = [], fxOn = false, fxStart = 0, org = [0, 0], raf = 0, last = 0, fh = 0, seen = true, cols: string[] = [], sparks: Spark[] = [];
  let sprites: { beans: HTMLCanvasElement[]; glow: HTMLCanvasElement; ray: HTMLCanvasElement; star: HTMLCanvasElement } | null = null;
  new IntersectionObserver(([e]) => { seen = e.isIntersecting; if (seen && !raf && (parts.some((q) => q.st < 2) || fxOn)) { last = 0; raf = requestAnimationFrame(tick); } }).observe(stage);
  function sizeFx() {
    const d = devicePixelRatio || 1;
    fh = stage.clientHeight; // el bitmap y su tamaño CSS quedan fijos aunque el escenario se achique al armar el abanico (si no, se estira)
    fx.style.height = fh + PAD + 'px';
    fx.width = stage.clientWidth * d; fx.height = (fh + PAD) * d;
    ctx.setTransform(d, 0, 0, d, 0, PAD * d);
  }
  const mk = (w: number, h: number, draw: (g: CanvasRenderingContext2D) => void) => {
    const c = document.createElement('canvas'); c.width = w; c.height = h; draw(c.getContext('2d')!); return c;
  };
  // se dibujan una sola vez; después solo se copian con drawImage
  function makeSprites() {
    const beans = BEANS.flatMap(([base, hi, dk]) => [19, 23].map((ry) => mk(144, 108, (g) => {
      g.scale(2, 2); g.translate(36, 27);
      const gr = g.createRadialGradient(-10, -9, 2, 0, 0, 36);
      gr.addColorStop(0, hi); gr.addColorStop(.45, base); gr.addColorStop(1, dk);
      g.fillStyle = gr; g.beginPath(); g.ellipse(0, 0, 31, ry, 0, 0, TAU); g.fill();
      g.lineWidth = 1.5; g.strokeStyle = dk; g.stroke();
      g.lineCap = 'round'; g.beginPath(); g.moveTo(-25, 2); g.bezierCurveTo(-12, -11, 2, 11, 25, -2);
      g.lineWidth = 3.6; g.strokeStyle = 'rgba(28,12,4,.9)'; g.stroke();
      g.translate(0, 1.6); g.lineWidth = 1.2; g.strokeStyle = 'rgba(255,214,170,.28)'; g.stroke(); g.translate(0, -1.6);
      g.rotate(-.35); g.fillStyle = 'rgba(255,240,220,.28)'; g.beginPath(); g.ellipse(-8, -ry * .55, 11, 3.6, 0, 0, TAU); g.fill();
    })));
    const glow = mk(128, 128, (g) => {
      const gr = g.createRadialGradient(64, 64, 0, 64, 64, 64);
      gr.addColorStop(0, 'rgba(255,248,228,.95)'); gr.addColorStop(.3, 'rgba(255,205,120,.6)'); gr.addColorStop(1, 'rgba(240,150,60,0)');
      g.fillStyle = gr; g.fillRect(0, 0, 128, 128);
    });
    const ray = mk(256, 64, (g) => {
      const gr = g.createLinearGradient(0, 0, 256, 0);
      gr.addColorStop(0, 'rgba(255,244,214,.85)'); gr.addColorStop(.5, 'rgba(255,200,110,.35)'); gr.addColorStop(1, 'rgba(255,190,100,0)');
      g.fillStyle = gr; g.beginPath(); g.moveTo(0, 30); g.lineTo(256, 0); g.lineTo(256, 64); g.lineTo(0, 34); g.fill();
    });
    const star = mk(64, 64, (g) => {
      g.translate(32, 32); g.beginPath(); g.moveTo(0, -30);
      for (const [x, y] of [[30, 0], [0, 30], [-30, 0], [0, -30]]) g.quadraticCurveTo(0, 0, x, y);
      g.closePath();
      const gr = g.createRadialGradient(0, 0, 0, 0, 0, 30);
      gr.addColorStop(0, '#fff'); gr.addColorStop(.35, '#FFE7A8'); gr.addColorStop(1, '#F0A93C');
      g.fillStyle = gr; g.fill();
    });
    return { beans, glow, ray, star };
  }
  // Granos que quedan en el piso: pocos, fuera de las figuritas (rects del abanico ya armado + margen), en los costados y en la franja de abajo.
  const REST = 7, REST_S = .55;
  let free: { x: number; y: number }[] = [];
  function restSpots() {
    const L = layout(), W = stage.clientWidth, ch = L.cw * 1.42, ys = L.pos.map((p) => p[1]), off = 28 - Math.min(...ys), cb = Math.max(...ys) + off + ch;
    const box = L.pos.map(([x, y]) => [x - 8, y + off - 8, x + L.cw + 8, y + off + ch + 8]);
    const out: { x: number; y: number }[] = [];
    for (let n = 0; n < 600 && out.length < REST; n++) {
      const x = Math.round(24 + Math.random() * (W - 48)), y = Math.round(cb + 22 - Math.random() ** 2 * 110);
      if (box.some(([a, b, c, d]) => x + 24 > a && x - 24 < c && y + 14 > b && y - 14 < d)) continue;
      if (out.some((o) => Math.hypot(o.x - x, (o.y - y) * 1.6) < 44)) continue;
      out.push({ x, y });
    }
    return out;
  }
  function settle(q: P, t: number, e: number) {
    let k = -1, m = 1e9;
    free.forEach((s, i) => { const d = Math.abs(s.x - q.x); if (d < m) { m = d; k = i; } });
    if (k < 0) { q.keep = false; q.dead = e + .4; return; }
    const [s] = free.splice(k, 1), wrap = (a: number) => a - TAU * Math.round(a / TAU);
    q.st = 1; q.tk = t; q.sx = q.x; q.sy = q.y; q.sr = q.r; q.sf = q.f; q.ss = q.s;
    q.tx = s.x; q.ty = s.y; q.tr = q.r + wrap((Math.random() - .5) * 1.6 - q.r); q.tf = Math.round(q.f / Math.PI) * Math.PI;
  }
  function burst(x: number, y: number) {
    sprites ||= makeSprites();
    cols = FX.map(css).concat(RAIN); org = [x, y]; fxOn = true; fxStart = performance.now();
    free = restSpots(); let kept = 0;
    sparks = Array.from({ length: 12 }, () => ({ x: x + (Math.random() - .5) * 340, y: y - 20 - Math.random() * 280, t0: Math.random() * .8, d: .5 + Math.random() * .6, s: 10 + Math.random() * 16, r: Math.random() * 1.5 }));
    for (let i = 0; i < 112; i++) {
      const a = -Math.PI / 2 + (Math.random() - .5) * 2.1, bean = i % 2 === 0, v = (bean ? 7 : 5) + Math.random() * (bean ? 9 : 10);
      parts.push({ x: x + (Math.random() - .5) * 60, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, r: Math.random() * TAU, vr: (Math.random() - .5) * (bean ? .16 : .3), f: Math.random() * TAU, vf: .08 + Math.random() * .14, ph: Math.random() * TAU,
        spr: bean ? sprites.beans[(Math.random() * 6) | 0] : null, c: cols[(Math.random() * cols.length) | 0], s: bean ? .3 + Math.random() * .2 : 5 + Math.random() * 6,
        dead: .9 + Math.random() * 1.1, t0: fxStart, keep: bean && kept++ < REST, st: 0, ts: .9 + Math.random() * .4, tk: 0, sx: 0, sy: 0, sr: 0, sf: 0, ss: 0, tx: 0, ty: 0, tr: 0, tf: 0 });
    }
    if (!raf) { last = 0; raf = requestAnimationFrame(tick); }
  }
  function tick(t: number) {
    if (!seen) { raf = 0; return; }
    const dt = last ? Math.min(40, t - last) / 16.7 : 1; last = t;
    const W = stage.clientWidth, H = fh, S = sprites!;
    ctx.clearRect(0, -PAD, W, H + PAD);
    ctx.lineCap = ctx.lineJoin = 'round';
    if (fxOn) {
      const e = (t - fxStart) / 1000, [ox, oy] = org;
      // arcoíris: 6 bandas onduladas que salen hacia arriba, se estiran y se recogen (doble trazo = borde de acuarela)
      const hd = Math.min(1, e / .8), head = 1 - Math.pow(1 - hd, 3), tl = Math.min(1, Math.max(0, (e - 1.1) / .8)), tail = tl * tl * (3 - 2 * tl);
      const Lm = oy + PAD - 16, al = Math.min(1, Math.max(0, (2.1 - e) / .5));
      if (tail < 1) for (let k = 0; k < 6; k++) for (const [lw, a, ph] of [[26, .45, 0], [15, .92, .9]]) {
        ctx.beginPath(); ctx.strokeStyle = RAIN[k]; ctx.lineWidth = lw; ctx.globalAlpha = a * al;
        for (let s = 0; s <= 32; s++) {
          const f = tail + (head - tail) * s / 32;
          const x = ox + (k - 2.5) * 17 * (1 + f * 1.5) + Math.sin(f * 8 - e * 9 + k * .35 + ph) * (8 + 28 * f);
          s ? ctx.lineTo(x, oy - f * Lm) : ctx.moveTo(x, oy - f * Lm);
        }
        ctx.stroke();
      }
      // luz cálida + rayos + destellos (aditivo: se suma sobre el arcoíris)
      ctx.globalCompositeOperation = 'lighter';
      const ge = e < .2 ? e / .2 : Math.max(0, 1 - (e - .2) / 1.1), gs = 200 + e * 150;
      if (ge > 0) { ctx.globalAlpha = ge; ctx.drawImage(S.glow, ox - gs, oy - gs * .8, gs * 2, gs * 1.4); }
      for (let i = 0; i < 9; i++) {
        const re = e - i * .04, env = re < 0 ? 0 : Math.sin(Math.min(1, re / 1.3) * Math.PI);
        if (env <= 0) continue;
        ctx.globalAlpha = env * .7; ctx.save(); ctx.translate(ox, oy);
        ctx.rotate(-Math.PI / 2 + (i - 4) * .26 + Math.sin(e * 1.5 + i) * .05);
        ctx.scale((260 + (i * 53) % 200) * (.6 + .4 * Math.min(1, e / .5)) / 256, .55 + (i % 3) * .3); ctx.translate(0, -32); ctx.drawImage(S.ray, 0, 0); ctx.restore();
      }
      for (const p of sparks) {
        const k = (e - p.t0) / p.d; if (k < 0 || k > 1) continue;
        const z = Math.sin(k * Math.PI), sz = p.s * z * 2;
        ctx.globalAlpha = z; ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r + k * .8); ctx.drawImage(S.star, -sz / 2, -sz / 2, sz, sz); ctx.restore();
      }
      ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1;
      if (e > 2.2) fxOn = false;
    }
    for (const q of parts) {
      const bean = !!q.spr, e = (t - q.t0) / 1000;
      let sh = 0;
      if (q.st === 1) { // se acomoda: llega plano, entero y con giro natural (nunca de canto)
        const k = Math.min(1, (t - q.tk) / 700), z = 1 - Math.pow(1 - k, 3);
        q.x = q.sx + (q.tx - q.sx) * z; q.y = q.sy + (q.ty - q.sy) * z; q.r = q.sr + (q.tr - q.sr) * z; q.f = q.sf + (q.tf - q.sf) * z; q.s = q.ss + (REST_S - q.ss) * z;
        sh = z; if (k === 1) q.st = 2;
      } else if (q.st === 2) sh = 1;
      else {
        q.vy += .28 * dt; q.vx *= Math.pow(bean ? .988 : .975, dt); q.vy *= Math.pow(bean ? .992 : .96, dt);
        q.x += (q.vx + (bean ? 0 : Math.sin(t * .006 + q.ph) * 1.1)) * dt; q.y += q.vy * dt; q.r += q.vr * dt; q.f += q.vf * dt;
        if (q.keep && ((e > q.ts && q.vy > 0) || e > 1.4)) settle(q, t, e);
      }
      const al = q.keep ? 1 : Math.max(0, Math.min(1, (q.dead - e) / .45));
      ctx.save(); ctx.globalAlpha = al; ctx.translate(q.st === 2 ? q.tx : q.x, q.st === 2 ? q.ty : q.y); ctx.rotate(q.r);
      const fl = .2 + .8 * Math.abs(Math.cos(q.f)); // vuelta 3D falsa: el eje corto se achata
      if (q.spr) {
        if (sh) { ctx.save(); ctx.translate(2.5, 4); ctx.fillStyle = `rgba(25,10,4,${.28 * sh})`; ctx.beginPath(); ctx.ellipse(0, 0, 29 * q.s, 20 * q.s * fl, 0, 0, TAU); ctx.fill(); ctx.restore(); }
        ctx.scale(q.s, q.s * fl); ctx.drawImage(q.spr, -36, -27, 72, 54);
      } else { ctx.fillStyle = q.c; ctx.fillRect(-q.s / 2, -q.s * fl / 4, q.s, q.s * fl / 2); }
      ctx.restore();
    }
    parts = parts.filter((q) => q.keep || (t - q.t0) / 1000 < q.dead);
    if (fxOn || parts.some((q) => q.st < 2)) raf = requestAnimationFrame(tick);
    else { raf = 0; last = 0; } // los granos ya en reposo quedan pintados, sin seguir animando
  }

  // ---------------------------------------------------------------- rasgado: la tira se despega de a poco, con tirones
  const body = $('.pack-body');
  let rest: HTMLElement | null = null;
  const BEATS = [[0, 0], [.14, .16], [.22, .18], [.42, .5], [.5, .52], [.72, .86], [.8, .88], [1, 1]];
  function tear(onBurst: () => void) {
    const w = top.offsetWidth, h = top.offsetHeight, N = 10, DUR = 1150;
    const jit = Array.from({ length: N + 1 }, () => (Math.random() - .5) * 7);
    const edge = (f: number) => jit.map((j, i) => `${f + j + (i / N - .5) * 8}px ${-6 + i * (h + 12) / N}px`).join(',');
    rest = top.cloneNode() as HTMLElement; rest.removeAttribute('data-top'); top.after(rest);
    const t0 = performance.now(); let pp = 0, pt = t0, v = 0, burst = false;
    const frame = (now: number) => {
      const u = Math.min(1, (now - t0) / DUR);
      let i = 1; while (BEATS[i][0] < u) i++;
      const [ua, pa] = BEATS[i - 1], [ub, pb] = BEATS[i], p = pa + (pb - pa) * (u - ua) / (ub - ua);
      const f = p * (w + 8);
      top.style.clipPath = `polygon(-6px -6px,${edge(f)},-6px ${h + 6}px)`;
      rest!.style.clipPath = `polygon(${w + 6}px -6px,${edge(f)},${w + 6}px ${h + 6}px)`;
      top.style.transformOrigin = `${f}px 100%`;
      top.style.transform = `translate(0px,${-p * 8}px) rotate(${4 + 50 * p}deg)`;
      v += ((p - pp) / Math.max(1, now - pt) * 1000 - v) * .3; pp = p; pt = now; // velocidad suavizada → el sobre se mece al revés del tirón
      body.style.transform = `translateX(${-v * 2.5}px) rotate(${-v * 1.6}deg) scaleY(${1 - v * .014})`;
      if (!burst && u > .8) { burst = true; onBurst(); }
      if (u < 1) return requestAnimationFrame(frame);
      top.style.clipPath = ''; rest!.remove(); rest = null;
      top.animate([{ transform: `translate(0px,-8px) rotate(54deg)`, opacity: 1 }, { transform: 'translate(70px,-230px) rotate(130deg)', opacity: 0 }], { duration: 650, easing: 'cubic-bezier(.2,.7,.3,1)', fill: 'forwards' });
      body.animate([{ transform: body.style.transform }, { transform: 'rotate(1.6deg)' }, { transform: 'none' }], { duration: 380, easing: 'ease-out' });
      body.style.transform = '';
    };
    requestAnimationFrame(frame);
  }

  // ---------------------------------------------------------------- abrir el sobre
  function open() {
    if (busy) return; busy = true;
    hand = elegirSobre(D.tostadores, D.cafes); // sorteo nuevo en cada sobre
    const L = layout(), ch = L.cw * 1.42;
    // las figuritas nacen ya en su lugar final (marco del escenario achicado); el escenario solo se achica al terminar, sin mover nada
    const dy = fitShift(L); cardsEl.style.transition = 'none'; cardsEl.style.transform = `translateY(${dy}px)`; cardsEl.offsetHeight; cardsEl.style.transition = '';
    const sr = stage.getBoundingClientRect(), pr = pack.getBoundingClientRect();
    const cx = pr.left - sr.left + pr.width / 2, ty = pr.top - sr.top + 40;
    cardsEl.innerHTML = hand.map((f) => cardHTML(f, L.cw)).join('');
    const cards = [...cardsEl.children] as HTMLElement[];
    if (!reduce) cards.forEach((el) => (el.style.opacity = '0')); // ocultas hasta que el sobre revienta

    if (reduce) { pack.classList.add('is-gone'); cards.forEach((el, i) => place(el, L.pos[i])); return done(cards); }

    pack.classList.add('is-open');
    tear(() => {
      burst(cx, ty);
      pack.animate([{ transform: 'none', opacity: 1 }, { transform: 'translateY(70px) scale(.9)', opacity: 0 }], { duration: 700, delay: 420, easing: 'ease-in', fill: 'forwards' })
        .finished.then(() => pack.classList.add('is-gone'));
      cards.forEach((el, i) => {
        const [x, y, r] = L.pos[i], rr = (Math.random() - .5) * 50;
        const sx = cx - L.cw / 2, sy = ty + 60 - ch / 2 - dy;
        const mx = cx - L.cw / 2 + (i - 2) * 120 + (Math.random() - .5) * 60, my = ty - ch - 40 - Math.random() * 60 - dy;
        el.animate([
          { transform: `translate(${sx}px,${sy}px) scale(.45) rotate(${rr}deg)`, opacity: 0 },
          { transform: `translate(${mx}px,${my}px) scale(.85) rotate(${-rr}deg)`, opacity: 1, offset: .45 },
          { transform: `translate(${x}px,${y}px) scale(1) rotate(${r}deg)`, opacity: 1 },
        ], { duration: 1150, delay: 120 + i * 90, easing: EASE, fill: 'both' })
          .finished.then(() => { place(el, L.pos[i]); el.getAnimations().forEach((a) => a.cancel()); });
        el.style.opacity = ''; // desde acá manda la animación (fill both)
        const inner = el.querySelector<HTMLElement>('.inner')!;
        inner.style.transform = 'rotateY(180deg)';
        inner.animate([{ transform: 'rotateY(180deg)' }, { transform: 'rotateY(0deg)' }], { duration: 700, delay: 650 + i * 110, easing: EASE, fill: 'forwards' })
          .finished.then((a) => { inner.style.transform = ''; a.cancel(); });
      });
      setTimeout(() => done(cards), 1900);
    });
  }

  // con el abanico armado el escenario se achica a lo que ocupan las figuritas (sin hueco antes del botón)
  const fitShift = (L: { pos: number[][] }) => 28 - Math.min(...L.pos.map((p) => p[1]));
  function fit(L: { cw: number; pos: number[][] }) {
    const ys = L.pos.map((p) => p[1]), pad = 28;
    const top = Math.min(...ys), bottom = Math.max(...ys) + L.cw * 1.42;
    stage.style.height = Math.ceil(bottom - top + pad * 2) + 'px';
    cardsEl.style.transform = `translateY(${pad - top}px)`;
  }
  const unfit = () => { stage.style.height = ''; cardsEl.style.transform = ''; };

  function done(cards: HTMLElement[]) {
    fit(layout());
    cards.forEach((el, i) => { tilt(el); el.addEventListener('click', () => showDetail(hand[i])); });
    again.hidden = false;
    status.textContent = '';
    setTimeout(() => (status.textContent = `salieron ${cards.length} cafés`), 50); // reanuncia aunque el texto sea el mismo
    cards[0]?.focus({ preventScroll: true });
    busy = false;
  }

  function reset() {
    if (busy) return; busy = true;
    again.hidden = true; status.textContent = '';
    const cards = [...cardsEl.children] as HTMLElement[];
    const finish = () => {
      cardsEl.innerHTML = '';
      parts = []; stage.style.transition = 'none'; unfit(); sizeFx(); stage.offsetHeight; stage.style.transition = '';
      packIdx = (packIdx + 1) % PACKS.length;
      pack.style.setProperty('--pack', `var(${PACKS[packIdx]})`);
      pack.getAnimations().concat(top.getAnimations()).forEach((a) => a.cancel());
      top.style.cssText = ''; rest?.remove(); rest = null;
      pack.classList.remove('is-open', 'is-gone');
      if (!reduce) pack.animate([{ transform: 'translateY(-80px)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 500, easing: EASE });
      busy = false; pack.focus({ preventScroll: true });
    };
    if (reduce || !cards.length) return finish();
    cards.forEach((el, i) => el.animate([{ opacity: 1 }, { transform: `${el.style.transform} translateY(120px) rotate(12deg)`, opacity: 0 }], { duration: 380, delay: i * 50, easing: 'ease-in', fill: 'forwards' }));
    setTimeout(finish, 380 + cards.length * 50);
  }

  // ---------------------------------------------------------------- detalle (<dialog>: Escape y foco los maneja el navegador)
  function showDetail(f: Figurita) {
    const c = f.tipo === 'cafe' ? f.cafe : null;
    $('[data-d-card]').innerHTML = cardHTML(f, Math.min(240, innerWidth - 100), 'div');
    tilt($('[data-d-card]').firstElementChild as HTMLElement);
    $('[data-d-por]').textContent = 'tostado por ' + f.tostador.nombre;
    $('[data-d-title]').textContent = c ? c.nombre : 'café de la semana';
    const rows = c
      ? [['origen', c.origen], ['proceso', c.proceso], ['variedad', c.variedad], ['mood', c.mood], ['notas', c.notas?.join(', ')]]
      : [['café', f.tipo === 'semana' ? f.texto : '']];
    $('[data-d-list]').innerHTML = rows.filter((r) => r[1]).map(([k, v]) => `<dt>${k}</dt><dd>${esc(v)}</dd>`).join('');
    dlg.showModal();
  }
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  // ---------------------------------------------------------------- arranque
  pack.addEventListener('click', open);
  againBtn.addEventListener('click', reset);
  sizeFx();
  let rt: number;
  addEventListener('resize', () => {
    clearTimeout(rt);
    rt = window.setTimeout(() => {
      if (busy) return;
      const fitted = !!cardsEl.children.length;
      if (fitted) { stage.style.transition = 'none'; unfit(); }
      sizeFx();
      const L = layout();
      if (fitted) { fit(L); stage.offsetHeight; stage.style.transition = ''; }
      parts = parts.filter((q) => q.st === 2); free = restSpots(); // granos en reposo: se reubican en el piso nuevo
      parts.forEach((q, i) => { const s = free[i]; if (s) { q.tx = s.x; q.ty = s.y; } else q.keep = false, q.dead = 0; });
      if (parts.length && !raf) { sprites ||= makeSprites(); last = 0; raf = requestAnimationFrame(tick); }
      ([...cardsEl.children] as HTMLElement[]).forEach((el, i) => { el.style.setProperty('--cw', L.cw + 'px'); place(el, L.pos[i]); });
    }, 150);
  });
</script>
