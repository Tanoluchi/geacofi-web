---
// Íconos de línea dibujados a mano, mismo trazo, en currentColor.
interface Props { name: 'whatsapp' | 'menu' | 'arrow'; size?: number; class?: string }
const { name, size = 22, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
  {name === 'whatsapp' && (<>
    <path d="M4 20l1.3-4A8 8 0 1 1 8.5 19z" />
    <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2z" />
  </>)}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
</svg>
