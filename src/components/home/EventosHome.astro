---
import { eventos } from '../../lib/data.ts';
import { partirEventos, fechaFlyer, fechaFlyerConAnio } from '../../lib/eventos.ts';
import Boton from '../shared/Boton.astro';
import EstadoVacio from '../shared/EstadoVacio.astro';
import Flyer from '../eventos/Flyer.astro';

const { proximos, pasados } = partirEventos(eventos);
const hayProximos = proximos.length > 0;
const lista = proximos.slice(0, 2);
const ultimos = pasados.slice(0, 2);
const giros = ['-3deg', '2.5deg'];
const girosChicos = ['-2deg', '1.5deg'];
---
<section class="banda" aria-labelledby="h-eventos">
  <div class="contenedor fila">
    <div class="texto">
      <h2 id="h-eventos" class="t-h2">qué pasa en geacofi</h2>
      <p>Sets de vinilos, catas y pop-ups. Los anunciamos acá y en Instagram.</p>
      <div class="botones">
        <Boton href="/eventos">ver eventos</Boton>
        {hayProximos && <Boton href="https://instagram.com/geacofi" variant="ghost">@geacofi</Boton>}
      </div>
    </div>
    <div class:list={['flyers', { vacio: !hayProximos }]}>
      {hayProximos ? lista.map((e, i) => (
        <article class="flyer" style={`--giro: ${giros[i]}`}>
          <Flyer evento={e} alto={200} />
          <h3>{e.titulo}</h3>
          <span class="fecha">{fechaFlyer(e)}</span>
          {e.descripcion && <p>{e.descripcion}</p>}
        </article>
      )) : (
        <>
          <EstadoVacio titulo="por ahora no hay eventos anunciados" texto="Mirá Instagram: ahí avisamos primero." pose="dormido">
            <Boton href="https://instagram.com/geacofi" variant="ghost">@geacofi</Boton>
          </EstadoVacio>
          {ultimos.length > 0 && (
            <div class="ultimos">
              <span class="t-eyebrow">lo último que hicimos</span>
              <div class="ultimos-fila">
                {ultimos.map((e, i) => (
                  <article class="mini" style={`--giro: ${girosChicos[i]}`}>
                    <Flyer evento={e} alto={180} />
                    <h3>{e.titulo}</h3>
                    <span class="mini-fecha">{fechaFlyerConAnio(e)}</span>
                  </article>
                ))}
              </div>
            </div>
          )}
        </>
      )}
    </div>
  </div>
</section>
<style>
  .fila { display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .texto { flex: 1 1 340px; display: flex; flex-direction: column; gap: var(--space-4); }
  .t-h2 { font-size: 84px; }
  .texto p { font-size: 18px; line-height: 27px; }
  .botones { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .flyers { flex: 1.4 1 480px; display: flex; flex-wrap: wrap; gap: 26px; justify-content: center; }
  /* sin próximos: el vacío arriba y los flyers viejos, chicos, abajo */
  .flyers.vacio { flex-direction: column; align-items: stretch; gap: var(--space-5); }
  .ultimos { display: flex; flex-direction: column; gap: var(--space-2); }
  .ultimos-fila { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  /* 150×180 = la proporción del flyer (900×1083): entra entero, sin recorte */
  .mini { display: flex; flex-direction: column; gap: 2px; width: 150px; transform: rotate(var(--giro)); }
  .mini h3 { font: 700 19px/1.25 var(--font-display); color: var(--terracota); overflow-wrap: anywhere; }
  .mini-fecha { font: italic 800 17px/1.2 var(--font-cond); color: var(--ink); }
  .flyer {
    position: relative; width: 270px; min-height: 300px; background: var(--crema); color: var(--bordo); border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-3) var(--space-4); transform: rotate(var(--giro)); display: flex; flex-direction: column; gap: var(--space-2);
    box-shadow: var(--drop); border: var(--border-dash) dashed var(--bordo);
  }
  .flyer h3 { font: 700 40px/.9 var(--font-display); color: var(--terracota); margin-top: var(--space-2); }
  .fecha { font: italic 800 24px/1 var(--font-cond); }
  .flyer p { font-size: 14px; line-height: 20px; color: var(--ink-dia); }
  @media (max-width: 640px) { .t-h2 { font-size: 56px; } .flyer { width: 100%; max-width: 270px; } .botones :global(.boton) { flex: 1 1 100%; justify-content: center; } }
</style>
