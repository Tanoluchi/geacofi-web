---
import { cafes } from '../../lib/data.ts';
import SobreCafes from '../sobre/SobreCafes.astro';
---
<section class="sobre" aria-labelledby="h-sobre">
  <div class="contenedor col">
    <div class="cab">
      <h2 id="h-sobre" class="t-h2">abrí un sobre, descubrí un café</h2>
      <div class="txt">
        <p>En Geacofi no tostamos: elegimos. Trabajamos con distintos tostadores y siempre estamos probando cosas nuevas.</p>
        <ul>
          {cafes.tostadores.map((t) => (
            <li><span class="punto" style={`background: var(--${t.color})`}></span>{t.nombre}</li>
          ))}
        </ul>
      </div>
    </div>
    <SobreCafes />
  </div>
</section>
<style>
  .sobre { padding: 70px var(--side) 90px; background: radial-gradient(ellipse at 50% 70%, #F7D6AC, var(--durazno) 70%); }
  .col { display: flex; flex-direction: column; gap: 30px; }
  .cab { display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: flex-end; justify-content: space-between; }
  .cab h2 { max-width: 11ch; }
  .txt { display: flex; flex-direction: column; gap: var(--space-3); max-width: 440px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  li {
    display: inline-flex; align-items: center; gap: var(--space-2); background: var(--crema); border: var(--border-dash) solid var(--bordo);
    border-radius: var(--radius-pill); padding: 6px 12px; font-weight: 800; font-size: 14px;
  }
  .punto { width: 12px; height: 12px; border-radius: 50%; border: var(--border-dash) solid var(--bordo); }
  @media (max-width: 640px) { .sobre { padding-block: var(--section-pad); } }
</style>
