---
import Boton from '../shared/Boton.astro';
import datos from '../../data/resenas.json';

const { puntaje, cantidad, url, items } = datos;
const n = items.length;
const nota = puntaje.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const flecha = 'M9 4l-8 8 8 8';
---
<section class="banda resenas" aria-labelledby="h-res">
  <div class="contenedor">
    <header class="cab">
      <span class="t-eyebrow">en google maps</span>
      <h2 id="h-res" class="t-h2">reseñas de google</h2>
      <p class="sub">lo que dicen quienes vienen</p>
      <p class="nota">
        <b>{nota}</b>
        <span class="estrellas" aria-hidden="true">★★★★★</span>
        <span>{cantidad} reseñas</span>
      </p>
    </header>

    <div class="car" data-res aria-roledescription="carrusel" aria-label="reseñas de google">
      <ul class="pista">
        {items.map((r, i) => (
          <li class="slide" data-slide={i} role="group" aria-roledescription="reseña" aria-label={`${i + 1} de ${n}`}>
            <figure>
              <blockquote><p>{r.texto}</p></blockquote>
              <figcaption>
                <span class="autor">{r.autor}</span>
                {r.meta && <span class="meta">{r.meta}</span>}
                <span class="meta">reseña de google · {r.cuando}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <div class="ctl">
        <button type="button" class="flecha" data-prev aria-label="reseña anterior"><svg viewBox="0 0 12 24" aria-hidden="true"><path d={flecha} /></svg></button>
        <div class="dots" role="group" aria-label="elegir reseña">
          {items.map((r, i) => <button type="button" class="dot" data-dot={i} aria-label={`reseña de ${r.autor}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
        </div>
        <button type="button" class="flecha sig" data-next aria-label="reseña siguiente"><svg viewBox="0 0 12 24" aria-hidden="true"><path d={flecha} /></svg></button>
      </div>
      <p class="sr-only" aria-live="polite" data-vivo></p>
    </div>

    <div class="acciones">
      <Boton href={url} variant="ghost" rel="noopener">ver las {cantidad} reseñas</Boton>
      <Boton href={url} rel="noopener">escribir la mía</Boton>
    </div>
  </div>
</section>

<style>
  .resenas {
    background: var(--verde); color: var(--crema);
    /* papel verde con la trama de puntos de la marca */
    background-image: radial-gradient(color-mix(in srgb, var(--crema) 22%, transparent) 1.2px, transparent 1.3px);
    background-size: 22px 22px;
  }
  .cab { display: grid; justify-items: center; text-align: center; gap: var(--space-2); }
  .resenas .t-eyebrow { color: color-mix(in srgb, var(--crema) 78%, transparent); }
  .resenas .t-h2 { color: var(--durazno); }
  .sub { margin: 0; color: color-mix(in srgb, var(--crema) 86%, transparent); }
  .nota { margin: var(--space-3) 0 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; font: 500 13px/16px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .nota b { font: 700 34px/1 var(--font-display); color: var(--durazno); letter-spacing: 0; }
  .estrellas { color: var(--durazno); font-size: 20px; letter-spacing: 2px; }

  .car { position: relative; max-width: 780px; margin: var(--space-6) auto 0; }
  .pista { list-style: none; margin: 0; padding: 0; }
  .slide { display: none; }
  .slide[data-activa] { display: block; }
  figure { margin: 0; background: var(--crema); color: var(--ink); border: var(--border-ink) solid var(--bordo); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); padding: var(--space-6) var(--space-5); display: grid; gap: var(--space-4); position: relative; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font: 400 clamp(19px, 2.1vw, 23px)/1.5 var(--font-body); }
  figcaption { display: grid; gap: 2px; }
  .autor { font: 700 20px/1.15 var(--font-body); color: var(--heading); }
  .meta { font: 500 12px/16px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted); }

  .ctl { display: flex; align-items: center; justify-content: center; gap: var(--space-4); margin-top: var(--space-5); }
  .flecha {
    flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; padding: 0; cursor: pointer;
    background: var(--durazno); color: var(--bordo); border: var(--border-ink) solid var(--bordo); box-shadow: var(--sticker-sm);
    transition: transform .15s ease-out, box-shadow .15s ease-out;
  }
  .flecha svg { width: 14px; height: 24px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .flecha.sig svg { transform: scaleX(-1); }
  .flecha:hover { transform: translate(-2px, -2px); box-shadow: var(--sticker-sm) ; }
  .flecha:active { transform: translate(3px, 3px); box-shadow: none; }
  .flecha:focus-visible, .dot:focus-visible { outline: 3px solid var(--durazno); outline-offset: 4px; }
  .dots { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; }
  .dot { position: relative; width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; }
  .dot::before { content: ''; position: absolute; top: 50%; left: 50%; width: 12px; height: 12px; translate: -50% -50%; border-radius: var(--radius-pill); border: 2px solid color-mix(in srgb, var(--crema) 70%, transparent); transition: width .3s cubic-bezier(.22, .8, .24, 1), background-color .3s; }
  .dot[aria-current='true']::before { width: 26px; background: var(--durazno); border-color: var(--durazno); }

  .acciones { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; margin-top: var(--space-6); }

  /* sin JS se ven todas las reseñas apiladas */
  .car:not(.js) .slide { display: block; margin-bottom: var(--space-4); }
  .car:not(.js) .ctl { display: none; }

  @media (max-width: 640px) {
    figure { padding: var(--space-5) var(--space-4); }
    .resenas .t-h2 { font-size: clamp(38px, 13vw, 54px); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-res]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const live = root.querySelector<HTMLElement>('[data-vivo]')!;
    const n = slides.length;
    if (n < 2) return;
    let cur = 0;
    root.classList.add('js');

    const render = (say = false) => {
      slides.forEach((s, i) => (i === cur ? s.setAttribute('data-activa', '') : s.removeAttribute('data-activa')));
      dots.forEach((b, i) => (i === cur ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
      if (say) live.textContent = `reseña de ${slides[cur].querySelector('.autor')!.textContent}, ${cur + 1} de ${n}`;
    };
    const go = (i: number, user = true) => { cur = ((i % n) + n) % n; render(user); };

    root.querySelector('[data-prev]')!.addEventListener('click', () => go(cur - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(cur + 1));
    dots.forEach((b, i) => b.addEventListener('click', () => go(i)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { go(cur - 1); e.preventDefault(); }
      else if (e.key === 'ArrowRight') { go(cur + 1); e.preventDefault(); }
    });

    let x0 = 0;
    root.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    root.addEventListener('pointerup', (e) => { const dx = e.clientX - x0; if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1)); });

    render();
  });
</script>
