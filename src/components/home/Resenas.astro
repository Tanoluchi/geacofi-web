---
import Boton from '../shared/Boton.astro';
import datos from '../../data/resenas.json';

const { puntaje, cantidad, url, items } = datos;
const nota = puntaje.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
// destello de cuatro puntas del sistema (DESIGN.md), en verde firma
const destello = 'M12 1.5c.9 5 3.6 7.7 8.6 8.6-5 .9-7.7 3.6-8.6 8.6-.9-5-3.6-7.7-8.6-8.6 5-.9 7.7-3.6 8.6-8.6z';
const giros = ['-1.2deg', '0.9deg', '1.1deg', '-0.7deg'];
---
<section class="banda resenas" aria-labelledby="h-res">
  <div class="contenedor">
    <header class="cab">
      <span class="t-eyebrow">en google maps</span>
      <h2 id="h-res" class="t-h2">reseñas de google</h2>
      <p class="sub">lo que dicen quienes vienen</p>
      <p class="nota">
        <span class="sr-only">{nota} de 5 — </span>
        <b>{nota}</b>
        <span class="estrellas" aria-hidden="true">
          {[1, 2, 3, 4, 5].map((i) => <svg viewBox="0 0 24 24" class={i === 5 ? 'casi' : undefined}><path d={destello} /></svg>)}
        </span>
        <span>{cantidad} reseñas en google</span>
      </p>
    </header>

    <ul class="muro">
      {items.map((r, i) => (
        <li class="papel" style={`--giro: ${giros[i % 4]}`}>
          <figure>
            <blockquote><p>{r.texto}</p></blockquote>
            <figcaption>
              <span class="autor">{r.autor}</span>
              <span class="meta">{[r.meta.toLowerCase(), r.cuando].filter(Boolean).join(' · ')}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="acciones">
      <Boton href={url} target="_blank">ver las {cantidad} reseñas</Boton>
      <Boton href={url} target="_blank" variant="ghost">escribir la mía</Boton>
    </div>
  </div>
</section>

<style>
  /* página crema entre dos bandas durazno: el verde vuelve a ser firma, no superficie */
  .resenas { background: var(--crema); }
  .cab { display: grid; justify-items: center; text-align: center; gap: var(--space-2); }
  .sub { margin: 0; color: var(--ink-muted); }
  .nota { margin: var(--space-3) 0 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; font: 500 13px/16px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .nota b { font: 700 34px/1 var(--font-display); color: var(--verde); letter-spacing: 0; }
  .estrellas { display: inline-flex; gap: 3px; }
  .estrellas svg { width: 17px; height: 17px; fill: var(--verde); }
  .estrellas .casi { fill: color-mix(in srgb, var(--verde) 34%, transparent); }

  .muro {
    list-style: none; margin: var(--space-6) 0 0; padding: 0;
    display: grid; gap: var(--space-5); grid-template-columns: 1fr;
  }
  .papel { rotate: var(--giro); container-type: inline-size; }
  figure {
    position: relative; margin: 0; height: 100%;
    background: var(--durazno); color: var(--ink);
    border: var(--border-ink) solid var(--bordo); border-radius: var(--radius-md);
    box-shadow: var(--shadow-card); padding: var(--space-5) var(--space-5) var(--space-4);
    display: grid; gap: var(--space-3); align-content: start;
  }
  /* cinta sobre el borde de arriba */
  figure::before {
    content: ''; position: absolute; top: -13px; left: 50%; translate: -50% 0; rotate: -2.5deg;
    width: 86px; height: 24px; border-radius: 2px;
    background: color-mix(in srgb, var(--crema) 88%, var(--bordo));
    box-shadow: 0 1px 0 color-mix(in srgb, var(--bordo) 22%, transparent);
  }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font: 400 clamp(18px, 5.2cqw, 21px)/1.5 var(--font-body); }
  figcaption { display: grid; gap: 3px; }
  .autor { font: 800 18px/1.15 var(--font-body); color: var(--terracota); }
  .meta { font: 500 13px/18px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }

  .acciones { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; margin-top: var(--space-6); }
  /* la tira fija del celular no tapa el cierre de la banda */
  @media (max-width: 760px) { .acciones { margin-bottom: 84px; } }

  @media (min-width: 760px) {
    .muro { grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-5); }
  }
</style>
