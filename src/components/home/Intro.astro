---
import { logoUrl } from '../../lib/assets.ts';
import ranaUrl from '../../assets/intro/rana-filtrado-verde.svg?url';

// Intro: la rana sirve el café, el vapor escribe "geacofi" y el telón se abre sobre el hero.
// render(t) es función pura del tiempo (como Artina): ?t=1.8 congela el cuadro.
// Trazos de la máscara: centro de cada letra en px del logo a 2x (viewBox 544×186 → 1088×372).
const letras = [
  'M130 135C105 100 50 105 36 160 30 215 80 235 128 215', // g: panza
  'M133 125L135 270C135 330 110 350 75 345 50 342 42 325 40 305', // g: palo y gancho
  'M215 215C260 215 310 210 335 175 345 140 300 105 255 125 205 150 185 215 205 255 230 295 290 270 335 250', // e
  'M490 150C465 108 405 115 390 180 380 235 425 262 470 240 498 225 502 195 492 150', // a: panza
  'M492 185C505 220 520 260 530 300', // a: pata
  'M672 142C640 122 590 150 575 205 565 260 620 285 685 268', // c
  'M770 130C730 125 715 190 722 235 730 275 800 280 810 235 820 190 795 135 765 128', // o
  'M920 310L918 130C915 70 935 35 960 45 990 55 995 70 992 85', // f: palo
  'M835 118L985 118', // f: travesaño
  'M1043 90L1048 300', // i
];
---
<div class="intro" data-intro hidden aria-label="Intro de geacofi" role="presentation">
  <div class="escena" aria-hidden="true">
    <svg viewBox="0 0 760 660" width="760" height="660" focusable="false">
      <defs>
        <mask id="intro-m" maskUnits="userSpaceOnUse" x="0" y="0" width="760" height="260">
          <g transform="translate(270 10) scale(.441)" fill="none" stroke="#fff" stroke-width="68">
            {letras.map((d) => <path d={d} pathLength="1" />)}
          </g>
        </mask>
      </defs>
      <image id="i-logo" href={logoUrl('bordo')} x="270" y="10" width="480" height="164" mask="url(#intro-m)" />
      <g id="i-rana">
        <defs>
          <clipPath id="i-cb"><path d="M368 456L494 456 470 478 436 495 405 483Z" /></clipPath>
          <clipPath id="i-cm"><rect x="392" y="510" width="76" height="42" rx="10" /></clipPath>
        </defs>
        <g clip-path="url(#i-cb)"><path id="i-nb" fill="#6B3E26" fill-opacity=".85" /></g>
        <g clip-path="url(#i-cm)"><path id="i-nm" fill="#6B3E26" fill-opacity=".85" /></g>
        <path id="i-gota" stroke="#6B3E26" stroke-opacity=".85" stroke-width="5" stroke-linecap="round" fill="none" />
        <image href={ranaUrl} x="0" y="0" width="540" height="570" />
        <path id="i-brillo" stroke="#E2B382" stroke-width="3" stroke-opacity=".8" stroke-linecap="round" fill="none" />
        <path id="i-chorro" fill="#6B3E26" fill-opacity=".85" stroke="#445012" stroke-width="4.5" />
        <g id="i-gotas" fill="#6B3E26" stroke="#445012" stroke-width="2.5">
          {[0, 1, 2, 3, 4, 5].map(() => <circle r="3.5" />)}
        </g>
      </g>
      <g class="trazo">
        {[
          'M500 550C470 520 548 500 566 462 584 424 574 392 592 356 610 320 586 292 604 252 614 226 606 210 610 192',
          'M520 550C500 520 566 508 580 476 596 440 612 420 632 388 650 356 628 330 646 292 656 266 650 236 660 214',
          'M486 550C466 524 524 504 548 470 570 436 546 418 570 384 590 352 566 326 584 288 596 262 584 240 590 212',
        ].map((d) => <path class="i-vapor" pathLength="1" d={d} />)}
      </g>
    </svg>
  </div>
  <button type="button" class="saltar-intro" data-skip>saltar intro</button>
</div>
<script is:inline>
  // Antes del primer pintado: solo se muestra con JS y sin reduced-motion; en cada carga del Home.
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('intro-on');
  })();
</script>
<script>
  const root = document.querySelector<HTMLElement>('[data-intro]')!;
  const on = document.documentElement.classList.contains('intro-on');
  if (!on) root.remove();
  else {
    const $ = (s: string) => root.querySelector<SVGElement>(s)!;
    const rana = $('#i-rana'), chorro = $('#i-chorro'), brillo = $('#i-brillo'), gota = $('#i-gota');
    const nb = $('#i-nb'), nm = $('#i-nm'), gotas = [...root.querySelectorAll<SVGElement>('#i-gotas circle')];
    const logo = $('#i-logo'), vapor = [...root.querySelectorAll<SVGElement>('.i-vapor')];
    const trazos = [...root.querySelectorAll<SVGElement>('mask path')];
    const skip = root.querySelector<HTMLElement>('[data-skip]')!;
    const frozen = new URLSearchParams(location.search).get('t');
    const DUR = 4.3, SALIDA = 3.6; // la salida (iris) arranca en 3.6 s
    const seg = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
    const eo = (x: number) => 1 - (1 - x) ** 3;
    const back = (x: number) => 1 + 2.7 * (x - 1) ** 3 + 1.7 * (x - 1) ** 2; // easeOutBack
    // cubic-bezier(.22,.8,.24,1) resuelto por Newton
    const bz = (x: number) => {
      let u = x;
      for (let i = 0; i < 6; i++) {
        const f = 3 * (1 - u) ** 2 * u * .22 + 3 * (1 - u) * u * u * .24 + u ** 3 - x;
        const d = 3 * (1 - u) ** 2 * .22 + 6 * (1 - u) * u * (.24 - .22) + 3 * u * u * (1 - .24);
        u -= f / (d || 1);
      }
      u = Math.min(1, Math.max(0, u));
      return 3 * (1 - u) ** 2 * u * .8 + 3 * (1 - u) * u * u + u ** 3;
    };
    // ventana de trazo [tail, head] sobre un path con pathLength=1
    const ventana = (el: SVGElement, head: number, tail: number) => {
      const len = Math.max(0, head - tail);
      el.style.opacity = len < .01 ? '0' : '1';
      el.setAttribute('stroke-dasharray', `${len} 2`);
      el.setAttribute('stroke-dashoffset', String(-tail));
    };
    // un trazo por letra, en orden de escritura, con tiempo repartido por largo aproximado
    const pesos = [1.1, 1.2, 1.8, 1.5, .5, 1.1, 1.4, 1.2, .5, .8];
    const suma = pesos.reduce((a, b) => a + b);
    const E0 = 2.3, E1 = 3.45; // el vapor escribe el lettering
    let acc = 0;
    const tramos = pesos.map((p) => { const a = E0 + (E1 - E0) * acc / suma; acc += p; return [a, E0 + (E1 - E0) * acc / suma]; });
    trazos.forEach((p) => { p.setAttribute('stroke-dasharray', '1 2'); });

    // chorro: cinta rellena (cúbica del pico a la superficie) con bordes que ondulan; todo en coordenadas de la imagen
    const SP = [356, 443]; // pico de la tetera en el SVG
    const bez = (P: number[][], u: number) => {
      const v = 1 - u, k = [v * v * v, 3 * v * v * u, 3 * v * u * u, u * u * u];
      return [0, 1].map((j) => P.reduce((a, p, i) => a + p[j] * k[i], 0));
    };
    const cinta = (P: number[][], a: number, b: number, w: number, t: number) => {
      const L: number[][] = [], R: number[][] = [], C: number[][] = [];
      for (let i = 0; i <= 14; i++) {
        const u = a + (b - a) * i / 14, [x, y] = bez(P, u), [x2, y2] = bez(P, Math.min(1, u + .02));
        let dx = x2 - x, dy = y2 - y; const n = Math.hypot(dx, dy) || 1; dx /= n; dy /= n;
        const h = w / 2 * (1 + .22 * Math.sin(u * 11 - t * 16)) * (1 - .25 * u);
        L.push([x - dy * h, y + dx * h]); R.push([x + dy * h, y - dx * h]); C.push([x - dy * h * .45, y + dx * h * .45]);
      }
      const f = (q: number[][]) => q.map((p) => p.map((v) => v.toFixed(1)).join(' ')).join('L');
      chorro.setAttribute('d', `M${f(L)}L${f(R.reverse())}Z`);
      brillo.setAttribute('d', `M${f(C.slice(1, -1))}`);
    };
    const nivel = (el: SVGElement, y0: number, y1: number, v: number, t: number) => {
      const y = y0 - (y0 - y1) * v;
      el.setAttribute('d', v <= 0 ? '' : `M350 ${y0 + 6}L350 ${y}${[0, 1, 2, 3, 4, 5].map((i) => `L${350 + 30 * (i + 1)} ${y + 2.5 * Math.sin(i * 2 + t * 9)}`).join('')}L530 ${y0 + 6}Z`);
    };
    const hide = (el: Element, v: boolean) => el.setAttribute('visibility', v ? 'hidden' : 'visible');

    const render = (t: number) => {
      // entra deslizando, se asienta, se inclina hacia la taza para volcar la tetera y vuelve
      const r = eo(seg(t, 0, .6));
      const tilt = eo(seg(t, .6, 1)) - eo(seg(t, 2, 2.4));
      const bob = tilt > .9 ? Math.sin((t - 1) * 11) : 0;
      const a = 11 * tilt + bob * .5, sq = tilt * .025;
      rana.setAttribute('transform', `translate(160 ${196 + (1 - r) * 110}) scale(.8) translate(270 565) rotate(${a}) scale(${1 + sq} ${1 - sq}) translate(-270 -565)`);
      rana.style.opacity = String(Math.min(1, r * 4));
      // nivel del café: cono y taza
      const pour = seg(t, 1, 1.15) * (1 - seg(t, 2, 2.3));
      const lb = seg(t, 1.1, 1.9), lm = seg(t, 1.35, 2);
      nivel(nb, 495, 458, eo(lb), t); nivel(nm, 556, 516, eo(lm), t);
      // el chorro nace en el pico, cae a la superficie y se afina al enderezarse
      const Lx = 428 + Math.sin(t * 7) * 2, Ly = 495 - 37 * eo(lb) - 2;
      const P = [SP, [SP[0] + 38, SP[1] - 16], [Lx - 8, Ly - 38], [Lx, Ly]];
      const head = eo(seg(t, 1, 1.2)), tail = eo(seg(t, 2.05, 2.3));
      const w = 15 * (1 - .6 * seg(t, 1.95, 2.3));
      hide(chorro, head - tail < .03); hide(brillo, head - tail < .03);
      if (head - tail >= .03) cinta(P, tail, head, w, t);
      // gotas: salpicadura donde cae y 3 últimas gotas del pico
      gotas.forEach((g, i) => {
        if (i < 3) { // salpicadura
          const ph = (t * 3.2 + i / 3) % 1, on = pour > .5 && head > .9;
          hide(g, !on);
          g.setAttribute('cx', String(Lx + (i - 1) * 22 * ph)); g.setAttribute('cy', String(Ly - 26 * ph * (1 - ph) * 4 + 2));
        } else { // cola: caen por el arco y se pierden en el cono
          const u = seg(t, 2.25 + (i - 3) * .12, 2.65 + (i - 3) * .12), on = u > 0 && u < 1;
          hide(g, !on);
          const [x, y] = bez(P, Math.min(1, .35 + u * .65)); g.setAttribute('cx', String(x)); g.setAttribute('cy', String(y + 18 * u * u));
        }
      });
      // gotero del cono a la taza
      const dr = pour * seg(t, 1.25, 1.4);
      gota.setAttribute('d', dr > .5 && lm < 1 ? `M433 498L${433 + Math.sin(t * 20)} ${516 + 40 * (1 - lm)}` : '');
      // vapor: 3 curvas que se dibujan, suben y se mecen; desde que la taza está llena fluyen hasta el lettering
      const alto = .5 + .5 * eo(seg(t, E0, E0 + .6));
      vapor.forEach((v, i) => {
        if (t < 2) return ventana(v, 0, 0);
        const ph = ((t - 2 - i * .28) / 1.1) % 1;
        if (ph < 0) return ventana(v, 0, 0);
        ventana(v, alto * Math.min(1, ph * 1.7), alto * Math.max(0, (ph - .5) * 2));
        v.setAttribute('transform', `translate(${Math.sin(t * 4 + i * 2.1) * 6} 0)`);
        if (v.style.opacity === '1') v.style.opacity = String(Math.min(1, (1 - ph) * 4) * (1 - seg(t, 3.1, 3.5)));
      });
      // lettering: máscara que sigue la escritura; al terminar se quita y queda nítido
      trazos.forEach((p, i) => p.setAttribute('stroke-dashoffset', String(1.001 - eo(seg(t, tramos[i][0], tramos[i][1])))));
      if (t >= E1) logo.removeAttribute('mask'); else logo.setAttribute('mask', 'url(#intro-m)');
      // salida: el iris se abre y deja ver el hero
      const s = bz(seg(t, SALIDA, DUR));
      const esc = root.firstElementChild as HTMLElement;
      esc.style.transform = `scale(${1 + .05 * s})`;
      root.style.setProperty('--r', `${s * 150}vmax`);
    };

    const abrir = () => document.documentElement.classList.add('intro-run');
    let prev: Element | null = null, y = 0, fin = false;
    const hijos = [...document.body.children].filter((e) => e !== root);
    const terminar = () => {
      if (fin) return;
      fin = true;
      document.documentElement.classList.remove('intro-on', 'intro-run');
      hijos.forEach((e) => e.removeAttribute('inert'));
      root.remove();
      scrollTo(0, y);
      if (prev instanceof HTMLElement && prev !== document.body) prev.focus({ preventScroll: true });
      removeEventListener('keydown', tecla);
    };
    const tecla = (e: KeyboardEvent) => { if (e.key === 'Escape') saltar(); };
    let t0 = 0;
    const saltar = () => { const now = (performance.now() - t0) / 1000; if (now < SALIDA) t0 -= (SALIDA - now) * 1000; };

    if (frozen !== null) {
      const t = parseFloat(frozen) || 0;
      abrir();
      render(t);
      if (t >= DUR) terminar();
    } else {
      prev = document.activeElement; y = scrollY;
      document.body.append(root);
      root.hidden = false;
      hijos.forEach((e) => e.setAttribute('inert', ''));
      skip.addEventListener('click', saltar);
      addEventListener('keydown', tecla);
      skip.focus({ preventScroll: true });
      abrir();
      t0 = performance.now();
      const paso = () => {
        const t = (performance.now() - t0) / 1000;
        render(Math.min(t, DUR));
        t >= DUR ? terminar() : requestAnimationFrame(paso);
      };
      paso();
    }
  }
</script>
<style is:global>
  /* sin JS (o sin la clase) la intro no existe: hidden por defecto y se muestra solo con html.intro-on */
  .intro[hidden] { display: none; }
  html.intro-on { overflow: hidden; }
  html.intro-on .intro[hidden] { display: grid; }
  .intro {
    --r: 0vmax;
    position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center;
    background: var(--durazno); overflow: hidden;
    -webkit-mask: radial-gradient(circle at 50% 52%, transparent var(--r), #000 calc(var(--r) + 1px));
    mask: radial-gradient(circle at 50% 52%, transparent var(--r), #000 calc(var(--r) + 1px));
  }
  .intro .escena { width: min(94vw, 920px, calc((100svh - 96px) * 1.15)); }
  .intro svg { display: block; width: 100%; height: auto; overflow: visible; visibility: hidden; }
  html.intro-run .intro svg { visibility: visible; }
  .intro .trazo { fill: none; stroke: var(--verde); stroke-width: 12; stroke-linecap: round; stroke-linejoin: round; }
  .intro .saltar-intro {
    position: absolute; right: var(--space-5); bottom: var(--space-5); min-height: 44px; padding: 8px 20px;
    font: italic 800 24px/1 var(--font-cond); text-transform: lowercase;
    color: var(--bordo); background: var(--crema); border: var(--border-ink) solid var(--bordo);
    border-radius: var(--radius-md); box-shadow: var(--sticker-sm); cursor: pointer;
    transition: transform .15s ease-out, box-shadow .15s ease-out;
  }
  .intro .saltar-intro:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--bordo); }
  .intro .saltar-intro:active { transform: translate(4px, 4px); box-shadow: none; }
</style>
