---
import { carta } from '../../lib/data.ts';
import { formatPrecio } from '../../lib/precio.ts';
import Boton from '../shared/Boton.astro';

const lados = ['calientes', 'frios'].map((id) => carta.categorias.find((c) => c.id === id)).filter((c) => !!c);
const bonus = carta.categorias.find((c) => c.id === 'panaderia-pasteleria');
const letra = (lado: string) => lado.replace('Lado ', '');
---
<section class="banda" aria-labelledby="h-carta">
  <div class="contenedor col">
    <div class="cab">
      <h2 id="h-carta" class="t-h2">la carta, lado A y lado B</h2>
      <Boton href="/carta" variant="ghost">el disco completo <span aria-hidden="true">→</span></Boton>
    </div>
    <div class="grilla">
      {lados.map((cat, i) => (
        <article class:list={['tarjeta', { noche: i === 1 }]} data-theme={i === 1 ? 'noche' : undefined}>
          <header>
            <span class="disquito" aria-hidden="true">{letra(cat!.lado)}</span>
            <div><span class="etq">{cat!.lado}</span><h3>{cat!.nombre}</h3></div>
          </header>
          <ol>
            {cat!.items.slice(0, 5).map((it, n) => (
              <li>
                <span class="n">{String(n + 1).padStart(2, '0')}</span>
                <span><b>{it.nombre}</b>{it.descripcion && <small>{it.descripcion}</small>}</span>
                <span class="t-price">{formatPrecio(it.precio)}</span>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
    {bonus && (
      <div class="bonus">
        <ul class="discos" aria-label="bonus tracks">
          {bonus.items.slice(0, 4).map((it) => <li>{it.nombre}</li>)}
        </ul>
        <span class="nota">+ bonus tracks: panadería y pastelería</span>
      </div>
    )}
  </div>
</section>
<style>
  .col { display: flex; flex-direction: column; gap: var(--space-6); }
  .cab { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); }
  .grilla { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 26px; }
  .tarjeta {
    background: var(--surface-raised); color: var(--ink); border: var(--border-ink) solid var(--border);
    border-radius: var(--radius-lg); padding: 26px; box-shadow: var(--shadow-card); min-width: 0;
  }
  .tarjeta header { display: flex; align-items: center; gap: var(--space-3); margin-bottom: 6px; }
  .disquito {
    flex: none; width: 54px; height: 54px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    background: var(--carbon); color: var(--durazno); font: italic 800 24px/1 var(--font-cond);
  }
  .noche .disquito { background: var(--terracota); }
  .etq { display: block; font: 400 11px/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
  h3 { font: italic 800 34px/1 var(--font-cond); color: var(--heading); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 28px 1fr auto; gap: 10px; padding: 10px 0; border-bottom: var(--border-dash) dotted var(--ink-muted); align-items: baseline; }
  li:last-child { border-bottom: 0; }
  .n { font: 400 13px/1 var(--font-mono); color: var(--terracota); }
  .noche .n { color: var(--ambar); }
  li b { display: block; font-weight: 800; font-size: 17px; line-height: 22px; }
  li small { display: block; font-size: 13px; line-height: 18px; color: var(--ink-muted); }
  .bonus { display: flex; flex-wrap: wrap; gap: 22px; align-items: center; justify-content: center; }
  .discos { display: contents; list-style: none; margin: 0; padding: 0; }
  /* sin fotos en alta todavía: discos lisos con el nombre del producto */
  .discos li {
    width: 150px; height: 150px; border-radius: 50%; padding: var(--space-3); border: var(--border-ink) solid var(--bordo);
    background: var(--carbon); color: var(--durazno); display: flex; align-items: center; justify-content: center; text-align: center;
    font: italic 800 22px/1 var(--font-cond);
  }
  .nota { font: 700 32px/1 var(--font-display); color: var(--terracota); transform: rotate(-4deg); }
  @media (max-width: 640px) {
    .tarjeta.noche { display: none; }
    .tarjeta li:nth-child(n+5) { display: none; }
    .cab :global(.boton) { align-self: stretch; justify-content: center; }
    .discos li { width: 110px; height: 110px; font-size: 18px; }
    .nota { font-size: 30px; }
  }
</style>
