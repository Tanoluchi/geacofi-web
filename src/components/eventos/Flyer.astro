---
import type { Evento } from '../../lib/types.ts';
import { fechaFlyer } from '../../lib/eventos.ts';

// Flyer de evento: foto si el dato la trae; si no, tratamiento tipográfico (nunca se inventa una imagen).
interface Props { evento: Evento; alto?: number }
const { evento, alto = 280 } = Astro.props;
---
{evento.flyer ? (
  <img src={evento.flyer} alt={`Flyer de ${evento.titulo}`} loading="lazy" decoding="async" style={`height:${alto}px`} />
) : (
  <div class="sinfoto" style={`height:${alto}px`} aria-hidden="true">
    <span class="f">{fechaFlyer(evento)}</span>
    <span class="t">{evento.titulo}</span>
  </div>
)}
<style>
  img { width: 100%; object-fit: cover; border-radius: var(--radius-sm); display: block; }
  .sinfoto {
    display: flex; flex-direction: column; justify-content: space-between; gap: 12px; padding: 16px;
    background: var(--durazno); color: var(--bordo); border: 2px solid var(--bordo); border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .f { font: italic 800 28px/1 var(--font-cond); }
  .t { font: 700 44px/.9 var(--font-display); color: var(--terracota); overflow-wrap: anywhere; }
</style>
